{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "surface-binding.schema.json",
  "title": "Visual Provenance Surface Binding",
  "type": "object",
  "required": [
    "schema_version",
    "surface_id",
    "surface_path",
    "template_id",
    "preserve",
    "local_additions",
    "deviations",
    "last_reviewed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "surface_path": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "local_additions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
