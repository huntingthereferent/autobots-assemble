{
  "schema": "public-trace-source-registry/v1",
  "purpose": "Inventory of candidate changing external traces for source-owned adapters. A listed source is NOT an integrated/live feed.",
  "source_rules": {
    "required": [
      "native_identity",
      "observed_at",
      "source_updated_at",
      "units",
      "spatial_precision",
      "source_url",
      "license",
      "verification_scope"
    ],
    "missing": "UNKNOWN—not zero",
    "connection": "No cross-source link without explicit rule and source-native evidence",
    "prediction": "Forecast/model != observation",
    "public": "Public website != unauthenticated API != full coverage"
  },
