{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuous Handoff Sidecar Example (proposed)",
  "description": "Read-only requirements/traversal projection. Not a replacement for native handoffs, evidence, or provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "referent",
    "source_node",
    "target_node",
    "nodes",
    "candidates",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "referent": {
      "type": "string",
      "minLength": 1
    },
    "source_node": {
      "type": "string",
      "minLength": 1
    },
    "target_node": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "source_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "relation",
          "required_conditions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "required_conditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "handoff_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "edge_id",
          "condition",
          "source_ref",
          "witness_ref",
          "reported_outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "witness_ref": {
            "type": "string",
            "minLength": 1
          },
          "reported_outcome": {
            "enum": [
              "SUPPORTED",
              "CONTRADICTED",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
